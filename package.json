{
  "name": "@patimweb/pi-mindplace",
  "version": "1.4.2",
  "description": "Optional local code-navigation graph for pi. Parses supported source with tree-sitter and provides relevance-ranked, character-budgeted graph queries with advisory lifecycle guidance.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "graphify",
    "mindplace",
    "mind-place",
    "code-graph",
    "knowledge-graph",
    "code-exploration",
    "code-navigation",
    "tree-sitter",
    "ast",
    "static-analysis",
    "pagerank",
    "louvain"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-mindplace.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-mindplace/issues"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test tests/binding-regressions.test.ts tests/build-tool.test.ts tests/csharp.test.ts tests/detect.test.ts tests/extract.test.ts tests/extraction-cache.test.ts tests/freshness-quality.test.ts tests/gitignore.test.ts tests/graph.test.ts tests/kotlin.test.ts tests/query.test.ts tests/tool-regressions.test.ts tests/viz.test.ts",
    "test:focused": "node --experimental-test-module-mocks --test tests/binding-regressions.test.ts tests/build-tool.test.ts tests/extraction-cache.test.ts tests/freshness-quality.test.ts tests/tool-regressions.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'",
    "mp2-eval:proposal": "node scripts/mp2-eval.mjs --proposal",
    "mp2-eval:smoke": "node scripts/mp2-eval.mjs --smoke",
    "mp2-eval:run": "node scripts/mp2-eval.mjs --run"
  },
  "dependencies": {
    "@sengac/tree-sitter-kotlin": "0.4.6",
    "npm-check-updates": "file:vendor/npm-check-updates",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.2",
    "tree-sitter-json": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "overrides": {
    "@sengac/tree-sitter-kotlin": {
      "npm-check-updates": "$npm-check-updates"
    },
    "@earendil-works/pi-ai": "1.2.0",
    "tree-sitter-c": "0.23.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@types/node": "22.19.19",
    "semantic-release": "^25.0.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-mindplace/main/screenshot.png"
  }
}
